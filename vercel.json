{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bybit.js": {
      "regions": ["fra1"],
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "host", "value": "garhy.tech" }],
      "destination": "/garhy-tech-corporate.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "host", "value": "www.garhy.tech" }],
      "destination": "/garhy-tech-corporate.html"
    },
    {
      "source": "/",
      "has": [{ "type": "header", "key": "host", "value": "garhy-gpt-oss-cloud-git-garhy-tech-corporate-preview-garhy.vercel.app" }],
      "destination": "/garhy-tech-corporate.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
