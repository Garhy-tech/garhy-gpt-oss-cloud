{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/bybit.js": {
      "regions": ["fra1"],
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/gt-bybit-app/gt-bybit/"
    },
    {
      "source": "/gt-bybit",
      "destination": "/gt-bybit-app/gt-bybit/"
    },
    {
      "source": "/gt-bybit/:path*",
      "destination": "/gt-bybit-app/gt-bybit/:path*"
    },
    {
      "source": "/assets/gt-bybit/icon-512.png",
      "destination": "/gt-bybit-app/assets/gt-bybit/icon-512.webp"
    },
    {
      "source": "/assets/gt-bybit/:path*",
      "destination": "/gt-bybit-app/assets/gt-bybit/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
      ]
    }
  ]
}
